# Comptes réels, empreintes de mots de passe et verrous locaux : ne jamais committer.
/storage/private/users.json
/storage/private/*.lock
/storage/private/login-*.json
/storage/private/.users-*

# Fichiers temporaires locaux.
*.tmp

/storage/data/**/.catalog-*
/storage/data/.catalog-*

# Messages clients et fichiers temporaires privés générés au fonctionnement.
/storage/private/messages.json
/storage/private/.catalog-*

# Contenu de l’accueil modifié par les administrateurs.
/storage/data/homepage.json

# Correspondances locales des anciennes adresses SEO.
/storage/data/seo-redirects.json

# Bibliothèque et photos réelles de la bannière Sherco.
/storage/data/sherco-banner.json
/uploads/homepage/*
!/uploads/homepage/.htaccess

# Campagnes et photos administrées localement ou en production.
/storage/data/promotions.json
/uploads/promotions/

# Thème public choisi depuis le dashboard (donnée locale, jamais livrée).
/storage/data/site-theme.json
